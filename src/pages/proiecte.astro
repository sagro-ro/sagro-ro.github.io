---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectMap from '../components/projects/ProjectMap.astro';
import ContactCta from '../components/sections/ContactCta.astro';
import '../styles/project-map.css';
---
<BaseLayout
  title="Localități cu implementări de irigații în România"
  description="Localități cu implementări Sagro. Marcajele grupează implementările pe județe."
>
  <section class="projects-intro">
    <div class="container">
      <p class="eyebrow">Implementări Sagro</p>
      <h1>Localități cu implementări.</h1>
      <p>Șase județe și 13 localități cu implementări Sagro. Selectează un județ pentru a vedea lista localităților.</p>
    </div>
  </section>
  <section class="projects-explorer" aria-label="Harta implementărilor Sagro pe județe">
    <div class="container">
      <ProjectMap />
    </div>
  </section>
  <ContactCta
    enquiryType="instalare"
    title="Următoarea discuție poate începe cu parcela ta."
    intro="Spune-ne ce suprafață vrei să irigi, ce cultură ai și de unde vine apa. Construim evaluarea pe informațiile fermei tale."
  />
  <script>
    import { initReveals } from '../scripts/reveal';
    initReveals();
  </script>
</BaseLayout>
