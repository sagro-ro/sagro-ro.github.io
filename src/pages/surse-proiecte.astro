---
import BaseLayout from '../layouts/BaseLayout.astro';
import CountyGallery from '../components/projects/CountyGallery.astro';
import { countyMedia } from '../data/county-media';
import { projectEvidenceNote } from '../data/project-evidence';
import { projects } from '../data/projects';
import '../styles/legal.css';
---
<BaseLayout
  title="Localități cu implementări de irigații"
  description="Localități cu implementări Sagro în șase județe, cu liste pentru fiecare județ."
>
  <header class="legal-hero">
    <div class="container">
      <p class="eyebrow">Implementări Sagro</p>
      <h1>Reperele din câmp, prezentate clar.</h1>
      <p>Explorează cele șase județe și 13 localități cu implementări Sagro, apoi deschide harta pentru a selecta un județ.</p>
    </div>
  </header>

  <article class="legal-body">
    <div class="container legal-prose">
      <section>
        <h2>Localitățile implementărilor</h2>
        <p>{projectEvidenceNote}</p>
        <p>Fiecare secțiune prezintă localitățile dintr-un județ. Pentru informații despre o soluție de irigații adaptată terenului tău, contactează echipa Sagro.</p>
        <p>Poți selecta fiecare județ în <a href="/proiecte/">harta localităților</a> pentru a vedea lista localităților.</p>
      </section>

      {projects.map((project) => {
        const photos = countyMedia[project.slug];
        return (
          <section class="project-evidence" id={`sursa-${project.slug}`} data-project-evidence>
            <p class="eyebrow">Județul {project.countyLabel}</p>
            <h2>Localități în județul {project.countyLabel}</h2>
            <p class="project-evidence__context" data-project-evidence-context>{projectEvidenceNote}</p>
            <ul data-project-localities>
              {project.localities.map((locality) => <li>{locality}</li>)}
            </ul>
            {photos && photos.length > 0 && (
              <CountyGallery countySlug={project.slug} countyLabel={project.countyLabel} photos={photos} />
            )}
            <p><a class="project-evidence__back" href={`/proiecte/#proiect-${project.slug}`}>Vezi județul în hartă</a></p>
          </section>
        );
      })}
    </div>
  </article>
</BaseLayout>
