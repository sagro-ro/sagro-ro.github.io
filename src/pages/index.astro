---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import JourneyCards from '../components/sections/JourneyCards.astro';
import ProcessSteps from '../components/sections/ProcessSteps.astro';
import SystemGrid from '../components/sections/SystemGrid.astro';
import PartnerStrip from '../components/sections/PartnerStrip.astro';
import FaqList from '../components/sections/FaqList.astro';
import ContactCta from '../components/sections/ContactCta.astro';
import SectionHeading from '../components/site/SectionHeading.astro';
import ButtonLink from '../components/site/ButtonLink.astro';
import ProjectMap from '../components/projects/ProjectMap.astro';
import { homeFaqs } from '../content/faqs';
import '../styles/sections.css';
import '../styles/project-map.css';
---
<BaseLayout title="Sisteme de irigații și service pentru ferme" description="Proiectare și instalare de sisteme de irigații, service și mentenanță pentru echipamente agricole de irigat în România.">
  <Hero />
  <JourneyCards />
  <SystemGrid />
  <ProcessSteps />
  <section class="section project-preview" data-home-projects>
    <div class="container">
      <div class="project-preview__top">
        <SectionHeading
          dark
          eyebrow="Implementări Sagro"
          title="Localități cu implementări în România."
          intro="Șase județe și 13 localități cu implementări Sagro. Selectează un județ pentru a vedea lista localităților."
        />
        <ButtonLink href="/proiecte/" variant="light">Vezi proiectele</ButtonLink>
      </div>
      <ProjectMap compact />
    </div>
  </section>
  <PartnerStrip />
  <FaqList items={homeFaqs} />
  <ContactCta />
  <script>
    import { initReveals } from '../scripts/reveal';
    initReveals();
  </script>
</BaseLayout>
