---
import { Image } from 'astro:assets';
import { resolveSourceImage, type SourceImageReference } from './local-images';

interface Props {
  record: SourceImageReference;
  class?: string;
  sizes?: string;
  widths?: number[];
  eager?: boolean;
}

const {
  record,
  class: className,
  sizes = '(min-width: 1120px) 50vw, 100vw',
  widths,
  eager = false,
} = Astro.props;

const image = resolveSourceImage(record);

const responsiveWidths = [...new Set(
  (widths ?? [Math.round(image.width / 2), image.width])
    .filter((width) => Number.isFinite(width) && width > 0 && width <= image.width),
)].sort((a, b) => a - b);
---
<Image
  src={image}
  alt={record.alt}
  width={image.width}
  height={image.height}
  widths={responsiveWidths}
  sizes={sizes}
  format="webp"
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : 'auto'}
  decoding="async"
  class={className}
/>
