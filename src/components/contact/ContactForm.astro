---
import { Send } from '@lucide/astro';
import type { EnquiryType } from '../../data/site';
import { site } from '../../data/site';

interface Props {
  endpoint: string | null;
  initialType: EnquiryType;
}
const { endpoint, initialType } = Astro.props;
---
<div class="contact-form-wrap">
  <div class="contact-form__intro">
    <p class="eyebrow">Solicitare Sagro</p>
    <h2 id="formular-title">Povestește-ne despre fermă sau echipament.</h2>
    <p>Câmpurile marcate cu * sunt necesare. Datele completate rămân în formular dacă trimiterea nu reușește.</p>
  </div>

  <form
    id="formular"
    class="contact-form"
    aria-labelledby="formular-title"
    data-contact-form
    data-endpoint={endpoint ?? ''}
    data-timeout-ms="12000"
    method="post"
    action={endpoint ?? undefined}
    novalidate
  >
    <div class="error-summary" data-error-summary role="alert" tabindex="-1" aria-labelledby="error-summary-title" hidden>
      <h3 id="error-summary-title">Verifică informațiile marcate.</h3>
      <ul data-error-summary-list></ul>
    </div>

    <fieldset disabled={!endpoint}>
      <legend>Ce tip de solicitare ai? *</legend>
      <div class="enquiry-types" data-error-for="type">
        <label for="tip-instalare">
          <input id="tip-instalare" type="radio" name="tip" value="instalare" data-field="type" checked={initialType === 'instalare'} aria-describedby="eroare-type" required />
          <span><strong>Instalare</strong> Sistem nou</span>
        </label>
        <label for="tip-service">
          <input id="tip-service" type="radio" name="tip" value="service" data-field="type" checked={initialType === 'service'} aria-describedby="eroare-type" required />
          <span><strong>Service</strong> Mentenanță</span>
        </label>
      </div>
      <p class="form-error" id="eroare-type" data-error-for="type"></p>

      <div class="form-grid">
        <div class="form-field">
          <label for="nume">Nume și prenume *</label>
          <input id="nume" name="nume" data-field="name" type="text" autocomplete="name" minlength="2" maxlength="100" required aria-describedby="eroare-nume" />
          <p class="form-error" id="eroare-nume" data-error-for="name"></p>
        </div>
        <div class="form-field">
          <label for="telefon">Telefon *</label>
          <input id="telefon" name="telefon" data-field="phone" type="tel" autocomplete="tel" maxlength="30" required aria-describedby="ajutor-telefon eroare-telefon" />
          <p class="form-hint" id="ajutor-telefon">Include prefixul țării dacă este necesar.</p>
          <p class="form-error" id="eroare-telefon" data-error-for="phone"></p>
        </div>
        <div class="form-field">
          <label for="email">Adresă de e-mail <span class="optional">(opțional)</span></label>
          <input id="email" name="email" data-field="email" type="email" autocomplete="email" maxlength="254" aria-describedby="eroare-email" />
          <p class="form-error" id="eroare-email" data-error-for="email"></p>
        </div>
        <div class="form-field">
          <label for="judet">Județ <span class="optional">(opțional)</span></label>
          <input id="judet" name="judet" data-field="county" type="text" autocomplete="address-level1" maxlength="100" aria-describedby="eroare-judet" />
          <p class="form-error" id="eroare-judet" data-error-for="county"></p>
        </div>
      </div>

      <div class="form-field">
        <label for="mesaj">Mesaj *</label>
        <textarea id="mesaj" name="mesaj" data-field="message" rows="7" minlength="20" maxlength="3000" required aria-describedby="ajutor-mesaj eroare-mesaj"></textarea>
        <p class="form-hint" id="ajutor-mesaj">Pentru un sistem nou, menționează suprafața, cultura și sursa de apă. Pentru service, descrie simptomele observate.</p>
        <p class="form-error" id="eroare-mesaj" data-error-for="message"></p>
      </div>

      <div class="consent-field">
        <input id="acord" name="consent" data-field="consent" type="checkbox" value="yes" required aria-describedby="eroare-acord" />
        <div>
          <label for="acord">Sunt de acord cu prelucrarea datelor pentru această solicitare. *</label>
          <p>Citește <a href="/politica-confidentialitate/">politica de confidențialitate</a>.</p>
          <p class="form-error" id="eroare-acord" data-error-for="consent"></p>
        </div>
      </div>

      <div class="form-honeypot" aria-hidden="true">
        <label for="website">Lasă acest câmp gol</label>
        <input id="website" name="website" data-field="website" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <button class="button button--primary form-submit" type="submit" disabled={!endpoint}>
        <span data-submit-label>Trimite solicitarea</span><Send aria-hidden="true" />
      </button>
    </fieldset>

    <div class="form-config" data-configuration-notice data-configured={endpoint !== null}>
      {endpoint ? (
        <p>Solicitarea este trimisă abia după apăsarea butonului. Pentru contact direct: <a href={site.phoneHref}>{site.phoneDisplay}</a> sau <a href={site.emailHref}>{site.email}</a>.</p>
      ) : (
        <>
          <p><strong>Formularul nu este conectat încă.</strong> Trimiterea online este dezactivată; nu vei primi o confirmare falsă.</p>
          <p>Contactează-ne direct la <a href={site.phoneHref}>{site.phoneDisplay}</a> sau <a href={site.emailHref}>{site.email}</a>.</p>
        </>
      )}
    </div>
    <p class="form-status" data-form-status data-state="idle" role="status" aria-live="polite" aria-atomic="true" tabindex="-1"></p>
  </form>
</div>
<script>
  import { initContactForm } from '../../scripts/contact-form';
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-contact-form]')) initContactForm(form);
</script>
