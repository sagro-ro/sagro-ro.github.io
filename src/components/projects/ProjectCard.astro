---
import type { Project } from '../../data/projects';
import { projectEvidenceNote } from '../../data/project-evidence';

interface Props {
  project: Project;
  compact?: boolean;
}
const { project, compact = false } = Astro.props;
const Heading = compact ? 'h3' : 'h2';
---
<article
  class="project-story"
  id={`proiect-${project.slug}`}
  data-project-story
  data-project-preview
  data-reveal
>
  <header class="project-story__header">
    <p class="project-story__location">Județul {project.countyLabel}</p>
    <Heading>Localități în județul {project.countyLabel}</Heading>
  </header>
  <ul data-project-localities>
    {project.localities.map((locality) => <li>{locality}</li>)}
  </ul>
  <p class="project-story__context" data-project-evidence-context>{projectEvidenceNote}</p>
  <footer>
    <a class="text-link project-source" href={project.sourceUrl}>
      Vezi contextul localităților
    </a>
  </footer>
</article>
